# Supabase Configuration
# Create a project at https://supabase.com
# You can find these values in your Supabase project under Settings > API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Note: Do not expose your service_role key here or anywhere on the client.

# AI Reply Assistant Configuration (Server-Side Only)
# Never prefix secret API keys with NEXT_PUBLIC_
OPENAI_API_KEY=your-openai-api-key
# Optional: default is gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Google Business Profile OAuth (Server-Side Only)
# Project: 248443327820
# Never prefix secret OAuth credentials with NEXT_PUBLIC_
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional redirect URI override (defaults to http://localhost:3001/api/auth/google/callback in local dev)
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Token Encryption Key (Server-Side Only, 32-byte secret for AES-256-GCM)
# Optional: falls back to securely derived key from server secrets if omitted
TOKEN_ENCRYPTION_KEY=your-32-byte-encryption-secret
